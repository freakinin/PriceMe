{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mkdir -p temp && TMPDIR=$(pwd)/temp tsx watch src/server.ts",
    "build": "cd ../../packages/shared && npm run build && cd ../../apps/api && tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
